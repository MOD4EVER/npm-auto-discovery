# ===================================================
# npm-auto-discovery — Environment Variables Reference
# ===================================================

# ---- REQUIRED ----------------------------------------

NPM_URL=http://npm:81
# Type: string (URL), Required: YES
# The base URL of your nginx-proxy-manager API (no trailing slash)

NPM_EMAIL=admin@example.com
# Type: string (email), Required: YES
# NPM admin account email

NPM_PASSWORD=changeme
# Type: string, Required: YES
# NPM admin account password

# ---- OPTIONAL (defaults shown) ----------------------

RECONCILE_INTERVAL_MS=300000
# Type: number (ms), Required: NO, Default: 300000
# How often the reconcile loop runs (5 minutes default)

FORWARD_HOST_MODE=auto
# Type: enum (auto|dns|ip), Required: NO, Default: auto
# Container hostname resolution: auto=DNS-first with IP fallback, dns=DNS only, ip=IP only

PROXY_NETWORK_NAME=proxy-network
# Type: string, Required: NO, Default: proxy-network
# Docker network name shared between npm-auto-discovery, NPM, and managed containers

NPM_MAX_RETRIES=3
# Type: number, Required: NO, Default: 3
# Maximum NPM API retry attempts with exponential backoff

HEALTH_PORT=8080
# Type: number (port), Required: NO, Default: 8080
# Port for the /health endpoint

NPM_CREDENTIALS_FILE=
# Type: string (path), Required: NO
# Path to a Docker secret file containing NPM_EMAIL and NPM_PASSWORD (KEY=VALUE format)
# When set, this file takes precedence over NPM_EMAIL/NPM_PASSWORD env vars

HOST_NETWORK_FORWARD_HOST=
# Type: string (IP or hostname), Required: NO
# Address NPM forwards to for containers running with network_mode: host
# (e.g. the proxy network's gateway IP or the server's public IP)

LOG_LEVEL=info
# Type: string, Required: NO, Default: info
# Pino log level: trace, debug, info, warn, error, fatal

DOCKER_GID=996
# Type: number (GID), Required: NO, Default: 996
# Host docker group GID — grants the container user access to /var/run/docker.sock
# Check with: stat -c '%g' /var/run/docker.sock
